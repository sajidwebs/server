NODE_ENV=production
PORT=5000
DB_HOST=your-render-postgres-host
DB_PORT=5432
DB_NAME=your-database
DB_USER=your-user
DB_PASSWORD=replace-in-render
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Stable 32-byte encryption key (64 hex characters); required for HR private fields and attachments.
HR_DATA_ENCRYPTION_KEY=replace-with-a-secure-32-byte-key
